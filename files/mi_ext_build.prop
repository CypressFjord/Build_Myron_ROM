#Redmi K90 Pro Max Prot
#mi_sw_sync改善因画面渲染不同步导致的丢帧卡顿问题
debug.sf.mi_asynchronous_re.enable=true
#Log
persist.logd.limit=OFF
persist.logd.size=65536
persist.logd.size.crash=1M
persist.logd.size.radio=1M
persist.logd.size.system=1M
log.tag.stats_log=OFF
ro.logd.size=64K
ro.logd.size.stats=64K
vendor.bluetooth.startbtlogger=false
persist.sys.offlinelog.kernel=false
sys.miui.ndcd=off
ro.kernel.android.checkjni=0
ro.kernel.checkjni=0
persist.wpa_supplicant.debug=false
persist.sys.offlinelog.logcat=false
persist.sys.offlinelog.logcatkernel=false
persist.sys.sysrqOnAnr_D_state=false 
persist.sys.wifi_track=false 
persist.vendor.wifienhancelog=0 
service.offlinelog.bootloader=false
persist.logd.diag.tcpdump=0
persist.sys.qseelogd=0
persist.sys.ssr.enable_debug=0
persist.vendor.sys.rawdump_copy=0
vendor.bluetooth.startbtlogger=0
persist.iorapd.log.verbose=false
#过渡动画
persist.sys.transition_rt.enable=true
persist.sys.transition_beginSchedThreads.enable=true
#ramdumps
persist.vendor.ssr.enable_ramdumps=0
#FPS
persist.vendor.disable_idle_fps.threshold=10
ro.vendor.display.primary_idle_refresh_rate=60,1:10
ro.vendor.mi_sf.aod_mode_ddic_refresh_rate=1
#补全刷新率档位
persist.sys.smartpower.limit.normal.max.refresh.rate.enable=true
persist.sys.smartpower.limit.normal.max.refresh.rate.support=120
persist.sys.smartpower.limit.max.refresh.rate=120
#动画调度器额外线程
persist.sys.miui_animator_sched.sched_threads=0
#扬声器清洁
ro.vendor.audio.clean_speaker=true
#开启高精定位
persist.vendor.gnss.hpLocSetUI=1
#游戏三倍速
debug.game.video.support=true
debug.game.video.speed=true
#启用音乐触感
ro.odm.mm.vibrator.audio_haptic_support=true
sys.haptic.media=true
sys.haptic.lowPowerMode=true
sys.haptic.onetrack=true
#启用触感UI2.0
sys.haptic.slide_version=2.0
#预加载
persist.sys.prestart.proc=false
persist.sys.preload.enable=false
persist.sys.prestart.feedback.enable=false
persist.sys.launch_response_optimization.enable=false
persist.sys.precache.enable=false
#Bootloader
ro.boot.flash.locked=1
ro.boot.verifiedbootstate=green
ro.secureboot.lockstate=locked
ro.boot.vbmeta.device_state=locked
ro.boot.vbmeta.digest=3234c28d825b3a1623d1983204c91fd8adc9c73e8a5f504d58fcf061ce3b210a
ro.boot.vbmeta.avb_version=1.0
ro.boot.vbmeta.hash_alg=sha256
ro.boot.vbmeta.size=4096
#dex2oat
persist.miui.dexopt.first_use=true
dalvik.vm.enable_pr_dexopt=true
dalvik.vm.boot-dex2oat-cpu-set=0,1,2,3,4,5,6,7
dalvik.vm.background-dex2oat-cpu-set=0,1,2,3,4,5,6,7